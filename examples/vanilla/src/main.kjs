가져오기 { 출력, 요소찾기, 기다리기 } 출처 "korean-code/runtime";

상수 버튼 = 요소찾기("#count");
상수 메시지 = 요소찾기("#message");
변수 횟수 = 0;

함수 그리기() {
  만약 (버튼) 버튼.textContent = String(횟수);
  만약 (메시지) 메시지.textContent = `마지막 클릭: ${횟수}`;
}

버튼?.addEventListener("click", 비동기 () => {
  횟수 += 1;
  그리기();
  기다림 기다리기(100);
  출력("클릭", 횟수);
});

그리기();
